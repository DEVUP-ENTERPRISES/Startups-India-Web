PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/incubation-platform
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:3000
INTERNAL_API_KEY=replace-with-internal-key

# Public origin of the Next.js app. Password reset links are built from this, so
# in production it MUST be the real site origin (boot fails on localhost).
FRONTEND_URL=http://localhost:3000

# Transactional email. Required in production — password reset depends on it.
# Leave SMTP_HOST empty in dev and reset emails are logged to the terminal instead,
# so you can copy the link straight out of the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@startupsindia.in
SUPPORT_EMAIL=support@startupsindia.in

# Password reset tuning
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60

# ── SMS / 2FA (phone OTP) ────────────────────────────────────────────────
# 'console' prints the OTP to the terminal — dev only. Production boot FAILS if
# this is left as 'console', so a real code can never end up only in the logs.
SMS_PROVIDER=console

# MSG91. IMPORTANT: sending transactional SMS to Indian numbers legally requires
# TRAI/DLT registration of your sender ID and message template. Start that
# paperwork early — it has a lead time and no code can work around it.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

DEFAULT_PHONE_COUNTRY=IN

OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Dedicated secret for HMAC-ing OTP codes at rest. Falls back to JWT_ACCESS_SECRET.
OTP_PEPPER=
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
FACEBOOK_APP_ID=replace_me
FACEBOOK_APP_SECRET=replace_me
LOG_LEVEL=info

# ── CRM bulk email ──
# Public origin of THIS API — used to build tracking/unsubscribe links that land
# in recipients' inboxes. MUST be publicly reachable in production.
API_PUBLIC_URL=http://localhost:5000
# Global ceiling on marketing emails per rolling 24h (the worker never exceeds it).
CRM_DAILY_CAP=100
