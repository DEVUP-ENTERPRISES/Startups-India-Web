{
  "name": "incubation-platform-backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:cluster": "pm2 start ecosystem.config.js",
    "start:prod": "pm2 start ecosystem.config.js --env production",
    "reload": "pm2 reload ecosystem.config.js",
    "stop": "pm2 stop ecosystem.config.js",
    "logs": "pm2 logs incubation-backend",
    "monit": "pm2 monit",
    "docker:build": "docker build -t incubation-backend .",
    "docker:run": "docker run -p 5000:5000 --env-file .env incubation-backend",
    "test": "node --test --test-concurrency=1 test/*.test.js test/e2e/*.e2e.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1020.0",
    "@aws-sdk/s3-request-presigner": "^3.1020.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^14.5.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.8",
    "morgan": "^1.12.1",
    "nodemailer": "^10.5.0",
    "razorpay": "^2.9.6",
    "redis": "^5.11.0",
    "stripe": "^22.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10",
    "nodemon": "^3.1.14"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.20.0",
      "follow-redirects": "^1.16.2",
      "brace-expansion@<2.1.7": "^2.1.7",
      "proxy-addr": "^2.0.8",
      "body-parser@1": "^1.20.9",
      "qs@6": "^6.16.1",
      "@fastify/busboy@3": "^3.2.5",
      "@grpc/grpc-js@1": "^1.14.5",
      "uuid@<11.1.1": "^11.1.1"
    }
  }
}
